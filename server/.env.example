# Обязательные
TG_APP_ID=123456
TG_APP_HASH=your_app_hash_here
JWT_SECRET=change-me-to-a-long-random-string

# Необязательные
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug
LOG_JSON=false
JWT_TTL=72h

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5s

# MTProxy — если пусто, подключение идёт напрямую
TG_PROXY_ADDR=
TG_PROXY_SECRET=
