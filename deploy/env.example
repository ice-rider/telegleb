# Шаблон .env для docker-compose.prod.yaml. Настоящий .env не коммитится.

# Telegram: берутся на https://my.telegram.org → API development tools
TG_APP_ID=
TG_APP_HASH=

# Длинная случайная строка: openssl rand -base64 48
JWT_SECRET=

# Необязательные
LOG_LEVEL=info
TLS_CERT_DIR=/etc/telegleb/certs

# MTProxy — оставить пустым для прямого подключения
TG_PROXY_ADDR=
TG_PROXY_SECRET=
